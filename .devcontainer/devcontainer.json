{
  "name": "Dux Niri Navigation (Dux 2.0.0)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "developer",
  "workspaceFolder": "/workspaces/dux-niri-navigation",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/dux-niri-navigation,type=bind",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "TheQtCompany.qt-qml",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "timonwong.shellcheck"
      ]
    }
  }
}
